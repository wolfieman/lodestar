{
  // Cloudflare Worker config for the hosted lean Lodestar build.
  // The Python full stack (CLI, hybrid RAG, MCP, FastAPI, Docker) is unaffected.
  "name": "lodestar",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // nodejs_compat is required by @anthropic-ai/sdk on the Workers runtime.
  "compatibility_flags": ["nodejs_compat"],

  // Single-source the rebranded index.html (+ favicon assets) from the same
  // static dir served by wsgi.py and web.py. If wrangler rejects this
  // outside-project path, the documented fallback is an npm prebuild copy step.
  // The ASSETS binding lets index.ts rewrite /static/* requests (Flask path
  // scheme) to the root-served asset paths, keeping index.html host-agnostic.
  "assets": { "directory": "../src/lodestar/static", "binding": "ASSETS" },

  "vars": {
    "TEST_MODE": "false",
    // Exact parity with the live cPanel env value (full dated id of claude-haiku-4-5).
    "LODESTAR_MODEL": "claude-haiku-4-5-20251001",
    // anthropic.py complete() default.
    "MAX_TOKENS": "1024"
  },

  // Hybrid RAG: Vectorize holds the seeded KB vectors (scripts/seed-vectorize.mjs);
  // Workers AI runs the SAME embedding model as the Python stack's fastembed
  // (bge-small-en-v1.5, 384 dims). Retrieval degrades to BM25-only if either fails.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "lodestar-kb" }],
  "ai": { "binding": "AI" },

  // GA top-level rate-limit config (wrangler >= 4.36.0). NOT the stale
  // unsafe.bindings form. Keyed per request on cf-connecting-ip in chat.ts.
  // Per-colo, approximate; the Anthropic spend cap is the true cost backstop.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],

  // Imports src/system-prompt.txt and src/context-preamble.txt as strings.
  // fallthrough keeps wrangler's DEFAULT Text rule (also covers .html/.sql) active.
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],

  "observability": { "enabled": true },

  // Production custom domains. Cloudflare creates and manages the DNS records
  // + certificates (any conflicting record must be deleted before first attach).
  // www serves the same app — kept alive for old links and type-in traffic.
  "routes": [
    { "pattern": "lodestar.sanyer.org", "custom_domain": true },
    { "pattern": "www.lodestar.sanyer.org", "custom_domain": true }
  ]
}
